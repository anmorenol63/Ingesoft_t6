{
  "name": "inventario-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:create": "node --env-file=.env ../database/crearBase.js",
    "db:migrate": "node --env-file=.env ../database/prepararDatos.js migrate",
    "db:seed": "node --env-file=.env ../database/prepararDatos.js seed",
    "db:reset-demo": "node --env-file=.env ../database/prepararDatos.js reset",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --env-file=.env --test tests/integration/*.test.js"
  },
  "dependencies": { "express": "^5.1.0", "pg": "^8.16.3" }
}
